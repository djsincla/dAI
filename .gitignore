# Python. .venv (3.14, MLX) and .venv-harvest (3.13, MLX + coremltools)
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/

# Spike artifacts — probe output is machine-specific and regenerable
*.jsonl
*.out.log
*.err.log
/spike/**/results/

# Model weights are large and fetched on demand, never committed. Anchored,
# because a bare `models/` also matched every source directory named Models -
# including the vendored library's, so the whole of MLXLLM/Models was silently
# absent from the repository along with the pipelining this fleet depends on.
/models/
control-plane/models/
*.safetensors
*.gguf
*.mlx

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# macOS
.DS_Store

# Core ML build artifacts (regenerable via e5_ane/build_model.py)
*.mlpackage/
*.mlmodelc/
spike/e5_ane/results*/

# Control plane
# Where a hand-started server writes; a running instance is a local thing.
control-plane/control-plane.log
control-plane/node_modules/
control-plane/dist/
control-plane/certs/

# Swift
agent/.build/

# packaging build products
agent/packaging/.staging/
agent/packaging/dist/
control-plane/packaging/.staging/
control-plane/packaging/dist/
# The bundled runtime, fetched from nodejs.org and checksum-verified at build
# time. Cached so a rebuild is not a download; never committed.
control-plane/packaging/.node-cache/
# Release output: two packages, their checksums and a note. Built from a tag,
# never committed - the packages are large and reproducible from the tag.
/dist/

# xcodebuild derived data (the GPU-capable build lives here, and the tests that
# need the Metal shaders run out of a second one)
agent/.xcbuild/
agent/.xcbuild-test/
# profiling output, from before coverage was disabled in the build
*.profraw

# Database dumps. These carry fleet data and are regenerable by scripts/backup.sh
control-plane/backups/

# The vendored fork keeps its own history in .git-fork so it can still be
# diffed against and rebased onto upstream. The parent repo tracks the source
# files themselves, so a fresh clone builds without a second checkout step.
agent/vendor/mlx-swift-examples/.git-fork/

# Scene bundles and rendered frames. Both are job data rather than source: a
# scene is tens of gigabytes and belongs to whoever submitted it, and the
# frames are the output, which the requester takes and the fleet then forgets.
control-plane/scenes/
control-plane/outputs/
# Content that arrived with a job. Held while the job runs and deleted after,
# which is the point of it - nothing here should ever reach a commit.
control-plane/blobs/
