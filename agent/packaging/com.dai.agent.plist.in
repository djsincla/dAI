<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. install.sh substitutes the values written in capitals between at
  signs, and writes the result to /Library/LaunchDaemons. A test renders this
  the same way and checks that nothing is left unsubstituted, because an
  unreplaced name is a literal string in a live configuration and fails as a
  path that does not exist rather than as a template error.

  A LaunchDaemon rather than a LaunchAgent, because E1 measured the difference
  and it decides what the product is. A daemon runs in session 0 as root with no
  user logged in, and Metal still works: 2/2 probes passed with the screen
  locked. An agent only exists while somebody is logged in, which would rule out
  exactly the overnight hours the whole premise depends on.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dai.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>@BINARY@</string>
    <string>work</string>
    <string>@URL@</string>
    <string>@MODEL@</string>
    <string>@ANE@</string>
  </array>

  <!--
    Drops to a service account. A daemon is needed because a LaunchAgent only
    exists inside a GUI login session and would be absent at the login window,
    which is exactly the overnight capacity this product is made of. Root is not
    needed for any of that: the work is inference, the Enclave key is sealed to
    the machine rather than gated on privilege, and presence comes from IOKit
    reads any user can make. Running as root would give a process that executes
    fleet-supplied payloads the whole machine.
  -->
  <key>UserName</key>
  <string>@USER@</string>

  <key>RunAtLoad</key>
  <true/>

  <!--
    Restart if it dies. ThrottleInterval stops a crash loop from becoming a
    busy loop: a control plane that is down should cost a connection attempt
    every 30s, not continuously.
  -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!--
    Standard, deliberately, and this is the setting most likely to be "fixed"
    by someone being helpful.

    Background looks like the polite choice and is the wrong one here. E1
    measured it at 2.4x on sustained GPU work and the worker found ~26x on
    bursty ANE items, and launchd's ProcessType applies for the life of the
    process: a daemon pinned to Background cannot promote itself when the user
    goes home, which is when nearly all the capacity is. The agent sets its own
    QoS per presence state instead, dropping to background the moment somebody
    is at the machine and lifting it when they are not. Setting it here takes
    that control away and costs most of the fleet's usable throughput.
  -->
  <key>ProcessType</key>
  <string>Standard</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!--
      NSHomeDirectory() reads the password database rather than HOME, so a
      daemon cannot be pointed at an identity by environment alone without
      this.
    -->
    <!--
      What this build is called, read at start by AgentVersion. A release has
      to be able to say what it deployed, and a binary that cannot name itself
      leaves an operator comparing file sizes over ssh - which is how two
      machines once spent a day on a build everybody believed had been
      replaced.
    -->
    <key>DAI_AGENT_VERSION</key>
    <string>@VERSION@</string>
    <key>DAI_IDENTITY_DIR</key>
    <string>@IDENTITY_DIR@</string>
    <!--
      The service account's home is /var/empty, so anything defaulting to
      ~/.cache writes nowhere. Model downloads have to be told where to land or
      the first GPU work unit fails on a path the logs will not explain.
    -->
    <key>DAI_PROMOTE_SECONDS</key>
    <string>@PROMOTE@</string>
    <!--
      The hub base, not the directory the weights sit in: the loader appends
      models/<repo> to whatever it is given, so naming the models directory
      produces models/models and a config.json nothing can find.
      DAI_MODEL_DIR is the one the agent reads; the HF variables are set for
      any library that looks for them, and are not a substitute.
    -->
    <key>DAI_MODEL_DIR</key>
    <string>@MODEL_DIR@</string>
    <key>HF_HOME</key>
    <string>@MODEL_DIR@</string>
    <key>HUGGINGFACE_HUB_CACHE</key>
    <string>@MODEL_DIR@</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>@STATE_DIR@</string>

  <key>StandardOutPath</key>
  <string>@LOG_DIR@/agent.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/agent.log</string>

  <!--
    Time to finish the item in flight on shutdown. The worker yields between
    items and reports what it completed, so a clean stop returns partial work
    rather than discarding a whole unit.
  -->
  <key>ExitTimeOut</key>
  <integer>30</integer>
</dict>
</plist>
