# The corpus and the index are built, not authored. Two commands rebuild them
# from the Legislature's own copy, and committing 35MB of vectors plus the cached
# HTML they came from would put a build artifact in the history for good.
corpus/
__pycache__/
*.pyc

# The VCF documentation PDF is 182 MB, which is both a build input rather than
# source and larger than GitHub accepts in a single file. vcf_fetch.py reads it
# from vcf91/ and everything downstream is rebuilt from it.
vcf91/
