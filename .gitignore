# Python. .venv (3.14, MLX) and .venv-harvest (3.13, MLX + coremltools)
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/

# Spike artifacts — probe output is machine-specific and regenerable
*.jsonl
*.out.log
*.err.log
/spike/**/results/

# Models are large and fetched on demand, never committed
models/
*.safetensors
*.gguf
*.mlx

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# macOS
.DS_Store

# Core ML build artifacts (regenerable via e5_ane/build_model.py)
*.mlpackage/
*.mlmodelc/
spike/e5_ane/results*/

# Control plane
control-plane/node_modules/
control-plane/dist/
control-plane/certs/

# Swift
agent/.build/

# packaging build products
agent/packaging/.staging/
agent/packaging/dist/

# xcodebuild derived data (the GPU-capable build lives here)
agent/.xcbuild/
# profiling output, from before coverage was disabled in the build
*.profraw

# Database dumps. These carry fleet data and are regenerable by scripts/backup.sh
control-plane/backups/

# The vendored fork keeps its own history in .git-fork so it can still be
# diffed against and rebased onto upstream. The parent repo tracks the source
# files themselves, so a fresh clone builds without a second checkout step.
agent/vendor/mlx-swift-examples/.git-fork/
