<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A LaunchAgent, unlike the worker, and that is the point. This runs in the
  logged-in user's session with their privileges and nothing more: it can read
  two files under /Users/Shared and write one of them. It cannot start, stop or
  configure the daemon, only ask it to pause by leaving a note.

  Installed for all users rather than one, because whoever sits at the machine
  should be able to see what it is doing and stop it, not only the person who
  happened to install the agent.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dai.menubar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/dAI.app/Contents/MacOS/dai-menubar</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!--
    Background QoS. This is a status icon that polls a file every two seconds;
    it must never be a reason anyone notices their machine.
  -->
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
